    {
        "id": "function_validate_joystick",
        "type": "function",
        "z": "main_flow",
        "name": "Validate Joystick",
        "func": "const data = msg.payload;\n\nif (!data || typeof data !== 'object') {\n    node.warn('Invalid joystick data: not an object');\n    return null;\n}\n\n// Convert to numbers explicitly (in case they come as strings)\nconst x = Number(data.x);\nconst y = Number(data.y);\n\nif (isNaN(x) || isNaN(y)) {\n    node.warn('Invalid joystick data: x or y not a valid number');\n    return null;\n}\n\nif (x < -1 || x > 1 || y < -1 || y > 1) {\n    node.warn('Joystick values out of range [-1, 1]');\n    return null;\n}\n\nconst magnitude = Math.sqrt(x * x + y * y);\n\nmsg.payload = [\n    {\n        measurement: 'joystick',\n        fields: {\n            x: x,\n            y: y,\n            magnitude: Math.round(magnitude * 1000) / 1000\n        },\n        tags: {\n            source: 'simulator'\n        },\n        timestamp: new Date(data.timestamp || Date.now())\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 100,
        "wires": [
            [
                "influx_out_joystick",
                "debug_joystick"
            ]
        ]
    },
    {
        "id": "function_validate_buttons",
        "type": "function",
        "z": "main_flow",
        "name": "Validate Buttons",
        "func": "const data = msg.payload;\n\nif (!data || typeof data !== 'object') {\n    node.warn('Invalid button data: not an object');\n    return null;\n}\n\n// Convert to number explicitly (in case it comes as string)\nconst pressed_count = Number(data.pressed_count);\n\nif (isNaN(pressed_count)) {\n    node.warn('Invalid button data: pressed_count not a valid number');\n    return null;\n}\n\nif (pressed_count < 0 || pressed_count > 6) {\n    node.warn('Button count out of range [0, 6]');\n    return null;\n}\n\nmsg.payload = [\n    {\n        measurement: 'buttons',\n        fields: {\n            pressed_count: Math.round(pressed_count)\n        },\n        tags: {\n            source: 'simulator'\n        },\n        timestamp: new Date(data.timestamp || Date.now())\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 200,
        "wires": [
            [
                "influx_out_buttons",
                "debug_buttons"
            ]
        ]
    },
