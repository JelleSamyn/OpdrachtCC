    {
        "id": "mqtt_in_buttons",
        "type": "mqtt in",
        "z": "main_flow",
        "name": "Buttons Input",
        "topic": "sensor/controller/buttons",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
